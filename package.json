  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "watch": "tsc -w",
    "dev": "NODE_OPTIONS='--no-warnings' SODIUM_NATIVE=1 nodemon dist/index.js",

    "nodemon": "^3.1.4",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@blockfrost/blockfrost-js": "^6.1.0",
    "@lucid-evolution/lucid": "^0.4.29",
    "bignumber.js": "^9.1.2",
    "cbor": "^8.1.0",
